  "code": "var D = [0x3F,0x06,0x5B,0x4F,0x66,0x6D,0x7D,0x07,0x7F,0x6F];\nfunction show(n, base) { for (var i = 0; i < 7; i++) digitalWrite(base + i, n < 0 ? 0 : (D[n] >> i) & 1); }var score=0, b=[{p:2,st:1,t:-99,f:function(){score=(score+1)%100;}},{p:12,st:1,t:-99,f:function(){score=0;}}];\nfunction setup(){for(var i=3;i<=11;i++)pinMode(i,OUTPUT);digitalWrite(10,1);digitalWrite(11,1);pinMode(2,INPUT_PULLUP);pinMode(12,INPUT_PULLUP);}\nfunction loop(){ var now=millis();\n  b.forEach(function(k){var r=digitalRead(k.p); if(r!==k.st && now-k.t>25){k.st=r;k.t=now;if(r===0)k.f();}});\n  digitalWrite(10,1);digitalWrite(11,1); show(Math.floor(score/10),3); digitalWrite(10,0); delay(1);\n  digitalWrite(10,1); show(score%10,3); digitalWrite(11,0); delay(1); }"
