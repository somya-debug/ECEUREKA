  "code": "// each LED: [anode pin, cathode pin]\nvar LED = { 1: [2, 3], 2: [3, 2], 3: [2, 4], 4: [4, 2], 5: [3, 4], 6: [4, 3] };\nvar PAT = [[1, 3, 5], [2, 4, 6], [1, 2, 3, 4, 5, 6]];\nvar pat = 0, st = HIGH, changedAt = -100;\n\nfunction setup() {\n  pinMode(5, INPUT_PULLUP);\n}\n\nfunction light(n) {\n  pinMode(2, INPUT); pinMode(3, INPUT); pinMode(4, INPUT);\n  pinMode(LED[n][0], OUTPUT); digitalWrite(LED[n][0], HIGH);\n  pinMode(LED[n][1], OUTPUT); digitalWrite(LED[n][1], LOW);\n}\n\nfunction loop() {\n  var list = PAT[pat];\n  for (var i = 0; i < list.length; i++) {\n    var now = millis(), r = digitalRead(5);\n    if (r !== st && now - changedAt > 25) {\n      st = r; changedAt = now;\n      if (r === LOW) pat = (pat + 1) % 3;\n    }\n    light(list[i]);\n    delay(1);\n  }\n}\n"
